{
	"name": "@iamprompt/n8n-nodes-stirlingpdf",
	"version": "0.1.2",
	"description": "n8n community node for Stirling-PDF",
	"publishConfig": {
		"access": "public"
	},
	"license": "MIT",
	"homepage": "https://github.com/iamprompt/n8n-nodes-stirlingpdf",
	"keywords": [
		"n8n-community-node-package",
		"stirling-pdf",
		"pdf"
	],
	"author": {
		"name": "iamprompt",
		"email": "iamprompt@users.noreply.github.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iamprompt/n8n-nodes-stirlingpdf.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"test:live": "vitest run test/live-api.test.ts",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"icons"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/StirlingPdfApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/StirlingPdf/StirlingPdf.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.51.4",
		"@types/node": "^22.13.10",
		"eslint": "^9.21.0",
		"n8n-workflow": "^2.16.0",
		"prettier": "^3.5.3",
		"typescript": "^5.8.2",
		"vitest": "^3.0.8"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
